{
  "id": "/",
  "name": "OCULTO — Conteúdo Exclusivo",
  "short_name": "OCULTO",
  "description": "Plataforma premium para casais liberais e criadores +18. Verificação, Modo Fantasma e chat criptografado.",
  "start_url": "/feed?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["social", "lifestyle", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Feed",
      "short_name": "Feed",
      "description": "Abrir o feed principal",
      "url": "/feed?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Radar",
      "short_name": "Radar",
      "description": "Quem está por perto agora",
      "url": "/radar?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mensagens",
      "short_name": "Chat",
      "description": "Abrir conversas",
      "url": "/messages?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Canais VIP",
      "short_name": "VIP",
      "description": "Canais VIP que você assina",
      "url": "/subscriptions?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Meu Perfil",
      "short_name": "Perfil",
      "description": "Abrir meu perfil",
      "url": "/profile?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
