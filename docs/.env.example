# ============================================================
# APP OCULTO — Variáveis de Ambiente (.env.example)
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NENHUMA dessas chaves depende do Lovable.

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...sua_anon_key...
VITE_SUPABASE_PROJECT_ID=SEU_PROJETO_ID
VITE_APP_URL=https://ocultoswing.com.br

# ── Edge Functions (Deno / Supabase Secrets) ────────────────
# Configure via: supabase secrets set CHAVE=valor

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Asaas (Gateway PIX)
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas

# OpenAI (Chat IA)
OPENAI_API_KEY=sk-...

# Cloudflare Stream (Transcoding de Vídeo)
CLOUDFLARE_ACCOUNT_ID=seu_account_id
CLOUDFLARE_STREAM_API_TOKEN=seu_api_token

# Discord (Alertas Admin)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# URL do App (usada em e-mails/redirects nas Edge Functions)
APP_URL=https://ocultoswing.com.br

# ── Opcionais ───────────────────────────────────────────────
# RESEND_API_KEY=re_...           # Se usar Resend para e-mails
# WHATSAPP_API_TOKEN=...          # WhatsApp Business API
# WHATSAPP_PHONE_NUMBER_ID=...    # ID do número WhatsApp
